{
  "rules": {
    ".read": true,
    ".write": true,
    "sailors": {
      ".indexOn": ["official_number", "trade", "category", "status", "rank", "zone_assigned"]
    },
    "availability": {
      ".indexOn": ["date", "official_number", "status"]
    },
    "work_orders": {
      ".indexOn": ["zone", "status", "trade", "priority", "created_at"]
    },
    "job_cards": {
      ".indexOn": ["project_id", "status", "job_number", "zone", "assigned_officer"]
    },
    "daily_allocations": {
      ".indexOn": ["date", "sailor_id", "official_number", "trade", "zone"]
    },
    "inventory": {
      ".indexOn": ["item_code", "category", "status"]
    },
    "estimates": {
      ".indexOn": ["estimate_no", "project_id", "status"]
    },
    "locations": {
      ".indexOn": ["zone_id", "code"]
    },
    "out_projects": {
      ".indexOn": ["id", "name", "status"]
    },
    "housing_projects": {
      ".indexOn": ["id", "name", "status"]
    },
    "nav254_vouchers": {
      ".indexOn": ["voucher_no", "date", "status"]
    },
    "lmd_records": {
      ".indexOn": ["record_id", "date"]
    },
    "naval_projects": {
      ".indexOn": ["id", "code", "voteNumber", "status", "priority", "projectType", "startDate", "endDate"]
    },
    "procurement_files": {
      ".indexOn": ["id", "projectId", "projectCode", "voteNumber", "prNumber", "presentPosition", "supplier", "date"]
    },
    "special_projects": {
      ".indexOn": ["id", "code", "category", "status", "start_date", "end_date"]
    },
    "special_project_attachments": {
      ".indexOn": ["project_id", "official_number", "trade", "status", "from_date", "to_date"]
    },
    "projects": {
      ".indexOn": ["id", "code", "category", "status"]
    },
    "attachments": {
      ".indexOn": ["project_id", "official_number", "trade", "status"]
    },
    "cmsys_absorption": {
      ".indexOn": ["status", "timestamp"]
    },
    "cmsys_absorption_history": {
      ".indexOn": ["published_at"]
    },
    "document_registry": {
      ".indexOn": [
        "id",
        "office_section",
        "flow_type",
        "ref_no",
        "file_no",
        "date_recorded",
        "date_letter",
        "present_position",
        "directed_to",
        "directed_type",
        "project_id",
        "priority",
        "status"
      ]
    },
    "job_minutes": {
      ".indexOn": [
        "id",
        "ref_no",
        "directed_to",
        "directed_type",
        "project_id",
        "date_received",
        "position",
        "priority"
      ]
    },
    "naval_letters": {
      ".indexOn": [
        "id",
        "letter_ref",
        "file_no",
        "letter_date",
        "security_class",
        "precedence",
        "br7_tone",
        "status",
        "is_registered_outgoing"
      ]
    },
    "file_registry": {
      ".indexOn": [
        "id",
        "file_no",
        "office_section",
        "category",
        "status"
      ]
    },
    "registry_prefixes": {
      ".indexOn": [
        "id",
        "office_section",
        "category",
        "flow_type",
        "is_default"
      ]
    },
    "minute_templates": {
      ".indexOn": [
        "id",
        "category",
        "lang"
      ]
    },
    "naval_letter_templates": {
      ".indexOn": [
        "id",
        "category",
        "security_class",
        "br7_tone"
      ]
    },
    "system_settings": {
      ".indexOn": [
        "updated_at"
      ]
    },
    "system_status": {
      ".indexOn": [
        "system",
        "version",
        "last_sync"
      ]
    }
  }
}
